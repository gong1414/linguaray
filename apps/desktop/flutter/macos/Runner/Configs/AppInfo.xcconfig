// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = LinguaRay

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = io.github.gong1414.linguaray

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 gong1414. MIT License.

// Open-source builds default to ad-hoc signing. Contributors who need stable
// macOS privacy grants across hot-reload builds can create the ignored
// DeveloperSigning.xcconfig from DeveloperSigning.xcconfig.example.
LINGUARAY_CODE_SIGN_IDENTITY = -
LINGUARAY_CODE_SIGN_STYLE = Manual
LINGUARAY_DEVELOPMENT_TEAM =
#include? "DeveloperSigning.xcconfig"

// Native Swift code imports the uniffi-generated linguaray_runtime
// bindings, whose C symbols are provided by Flutter's native_assets framework.
// Link the host app against that bundled framework so dyld resolves those
// symbols before any Swift startup code runs.
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(BUILT_PRODUCTS_DIR)/native_assets"
OTHER_LDFLAGS = $(inherited) -framework linguaray_runtime
