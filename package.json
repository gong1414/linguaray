{
  "name": "linguaray",
  "version": "0.1.0",
  "description": "Open-source, AI-native translation desktop app for macOS and Windows",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev --config src-tauri/tauri.debug.conf.json",
    "build:local": "tauri build --config src-tauri/tauri.noupdater.conf.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test e2e",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test:visual": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@storybook/test-runner": "^0.24.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.1",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "postcss-nesting": "^14.0.1",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "^9.1.20",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
