{
  "name": "linguaray",
  "version": "0.1.0",
  "description": "Open-source, AI-native translation desktop app for macOS and Windows",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev --config src-tauri/tauri.debug.conf.json",
    "build:local": "bash scripts/build-local.sh",
    "build:dmg": "bash scripts/build-local.sh dmg",
    "bindings:generate": "cargo test --manifest-path src-tauri/Cargo.toml --test bindings export_typescript_bindings -- --ignored --exact",
    "bindings:check": "cargo test --manifest-path src-tauri/Cargo.toml --test bindings generated_bindings_are_current -- --exact",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --ci --failOnConsole",
    "test:visual": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/x": "2.9.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "antd": "6.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@storybook/test-runner": "^0.23.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.1",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "storybook": "^9.1.20",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
